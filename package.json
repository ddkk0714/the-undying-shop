{
  "name": "the-undying-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "art": "node tools/scan-art.mjs && node tools/check-art.mjs && node tools/art-sheet.mjs",
    "art:fix": "node tools/check-art.mjs --fix && node tools/scan-art.mjs",
    "art:placeholder": "node tools/gen-placeholder.mjs",
    "art:sheet": "node tools/art-sheet.mjs",
    "predev": "node tools/scan-art.mjs && node tools/check-art.mjs",
    "dev": "vite",
    "prebuild": "node tools/scan-art.mjs && node tools/check-art.mjs --strict",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vitest run tests/sim.spec.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
